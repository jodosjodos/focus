PORT=3000

DATABASE_URL=postgresql://focus:focus@localhost:5433/focus

JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_IN=7d

# NestJS Observe (APM) — optional, dev-only.
# Sign up at https://observe.nestjs.com, create a service, and paste the issued
# pair here. The secret is shown once and is not retrievable afterwards.
# Left blank, the agent never registers and the app runs exactly as before.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=focus-backend-dev
